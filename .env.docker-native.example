# ==========================================
# Docker Native Configuration
# ==========================================
# Complete, self-contained profile for Docker Compose with MinIO storage.
#
# Quick start:
#   cp .env.docker-native.example .env
#   just env-setup && just env-github
# ==========================================

# ==========================================
# API Credentials (Required)
# ==========================================

# GitHub token for repository operations
# GITHUB_TOKEN=

# Anthropic API key for Guide (or use `fit-guide login` for OAuth)
# ANTHROPIC_API_KEY=

# AWS credentials for S3-compatible storage (e.g., MinIO)
# When you use local MinIO, `just env-setup` generates these
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# MCP bearer token for the MCP service endpoint
# `just env-setup` generates it
# MCP_TOKEN=

# HMAC secret for inter-service authentication
# `just env-setup` generates it
# SERVICE_SECRET=

# Database credentials for PostgreSQL
# `just env-setup` generates them
# DATABASE_PASSWORD=

# ==========================================
# Proxy Configuration
# ==========================================
# Required for containers to access external APIs through the gateway.

HTTPS_PROXY=http://gateway.local:3128
HTTP_PROXY=http://gateway.local:3128
NO_PROXY=localhost,127.0.0.1,*.local

# ==========================================
# Core Services
# ==========================================

SERVICE_SPAN_URL=grpc://localhost:3001
SERVICE_VECTOR_URL=grpc://localhost:3002
SERVICE_GRAPH_URL=grpc://localhost:3003
SERVICE_MAP_URL=grpc://localhost:3004
SERVICE_PATHWAY_URL=grpc://localhost:3005

# ==========================================
# Hosted Control Plane — Tenant Registry (Optional)
# ==========================================
# Hosted, multi-tenant deployments only (services/tenancy). Internal gRPC
# registry. It does not start in single-tenant self-hosted mode.
# See services/tenancy/README.md

# SERVICE_TENANCY_URL=grpc://localhost:3006

# ==========================================
# Hosted Control Plane — GitHub App Custody (Optional)
# ==========================================
# Hosted, multi-tenant deployments only (services/ghserver). Holds the key
# for the GitHub server App. Mints repo-scoped installation tokens. Internal
# gRPC (loopback). App config: services/ghserver/github-app.md.
# See services/ghserver/README.md

# SERVICE_GHSERVER_URL=grpc://localhost:3007
# SERVICE_GHSERVER_APP_ID=
# SERVICE_GHSERVER_PRIVATE_KEY=

# ==========================================
# Hosted Control Plane — OIDC Exchange (Optional)
# ==========================================
# Hosted, multi-tenant deployments only (services/oidc). Public HTTP front
# that validates a GitHub Actions OIDC token. It asks ghserver to mint the
# installation token.
# See services/oidc/README.md

# SERVICE_OIDC_URL=http://localhost:3008
# SERVICE_OIDC_PROVIDER=ghserver

# ==========================================
# GitHub User Auth (Optional)
# ==========================================
# Required when you run per-user GitHub auth (services/ghuser).
# See services/ghuser/README.md and services/ghuser/github-app.md

# Credentials for the Kata Agent User GitHub App
# SERVICE_GHUSER_CLIENT_ID=
# SERVICE_GHUSER_CLIENT_SECRET=

# Service configuration (no trailing slashes on URLs)
# SERVICE_GHUSER_URL=grpc://localhost:3009
# SERVICE_GHUSER_LINK_BASE_URL=

# ==========================================
# OAuth Service (Optional)
# ==========================================
# Required when you run the OAuth authorization server (services/oauth).
# See services/oauth/README.md

# SERVICE_OAUTH_URL=http://localhost:3010
# SERVICE_OAUTH_PROVIDER=ghuser

# ==========================================
# MCP Service (Optional)
# ==========================================
# Required when you run the MCP tool server (services/mcp).

# SERVICE_MCP_URL=http://localhost:3011

# ==========================================
# Bridge Store Service (Optional)
# ==========================================
# Required when you run either the GitHub or Teams bridge.
# Canonical discussion and origin store for both bridges.
# See services/bridge/README.md

# SERVICE_BRIDGE_URL=grpc://localhost:3012

# ==========================================
# GitHub Discussions Bridge (Optional)
# ==========================================
# Required when you run the Discussions ↔ Kata agent bridge (services/ghbridge).
# Also requires SERVICE_GHUSER_URL and SERVICE_BRIDGE_URL above.
# See services/ghbridge/README.md and services/ghserver/github-app.md (self-hosted vs hosted)

# Credentials for the Kata Agent Team GitHub App
# SERVICE_GHBRIDGE_APP_ID=
# SERVICE_GHBRIDGE_APP_INSTALLATION_ID=
# SERVICE_GHBRIDGE_APP_PRIVATE_KEY=
# SERVICE_GHBRIDGE_APP_WEBHOOK_SECRET=

# Bridge configuration (no trailing slashes on URLs)
# SERVICE_GHBRIDGE_URL=http://localhost:3013
# SERVICE_GHBRIDGE_GITHUB_REPO=
# SERVICE_GHBRIDGE_CALLBACK_BASE_URL=
# Deployment mode: single (self-hosted) or multi (hosted; needs tenancy + ghserver)
# SERVICE_GHBRIDGE_TENANCY_MODE=single

# ==========================================
# MS Teams Bridge (Optional)
# ==========================================
# Required only when you run the Teams ↔ Kata agent bridge (services/msbridge).
# Also requires SERVICE_GHUSER_URL and SERVICE_BRIDGE_URL above.
# See services/msbridge/README.md and services/msbridge/azure-app.md (self-hosted vs hosted)

# Credentials for the Azure AD app registration
# MICROSOFT_APP_ID=
# MICROSOFT_APP_TENANT_ID=
# MICROSOFT_APP_PASSWORD=

# Bridge configuration (no trailing slashes on URLs)
# SERVICE_MSBRIDGE_URL=http://localhost:3014
# SERVICE_MSBRIDGE_GITHUB_REPO=
# SERVICE_MSBRIDGE_CALLBACK_BASE_URL=
# Deployment mode: single (self-hosted) or multi (hosted; needs tenancy + ghserver)
# SERVICE_MSBRIDGE_TENANCY_MODE=single

# ==========================================
# Embedding Service (Optional)
# ==========================================
# gRPC endpoint for the embedding service (wraps TEI internally).
# Start with: just tei-start

# SERVICE_EMBEDDING_URL=grpc://embedding.local:3015

# ==========================================
# Supabase (single instance for all products)
# ==========================================
SUPABASE_URL=http://supabase-kong.local:8000
# `just env-setup` generates these:
# JWT_SECRET=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ==========================================
# Storage — MinIO (S3-compatible)
# ==========================================

STORAGE_TYPE=s3
S3_REGION=us-east-1
S3_BUCKET_NAME=data
AWS_ENDPOINT_URL=http://storage-minio.local:9000

# ==========================================
# GetDX API (Map activity pipeline)
# ==========================================

# GETDX_API_TOKEN=
GETDX_BASE_URL=https://api.getdx.com

# ==========================================
# Debug (Optional)
# ==========================================

# Debug output is off by default. It uses the `debug` package. The `*`
# wildcard also switches on verbose internal logs in third-party tools
# (eslint code-path dumps, etc.). It can bury real output. Scope DEBUG to
# our own namespaces. Use `*` only when you need everything.
# DEBUG=mcp,graph
# DEBUG=*
